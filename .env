# Where the 8th Wall engine is loaded from. Defaults to the public CDN, which needs no account
# and no app key since the hosted platform shut down and the engine became freely distributed.
#
# Run `npm run vendor:engine` to copy the engine into public/vendor/ and point these at your own
# origin instead. That is what makes offline development and headless testing possible; it writes
# a .env.local, which overrides this file and is gitignored.
VITE_XR8_URL=https://cdn.jsdelivr.net/npm/@8thwall/engine-binary@1/dist/xr.js
VITE_XREXTRAS_URL=https://cdn.jsdelivr.net/npm/@8thwall/xrextras@1/dist/xrextras.js
VITE_LANDING_PAGE_URL=https://cdn.jsdelivr.net/npm/@8thwall/landing-page@1/dist/landing-page.js
